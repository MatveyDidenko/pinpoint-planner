exports[`renderBlock option renderBlock is deterministic 1`] = `"<section class="block block--option block--recommended" id="block-opt-a" data-block="opt-a" data-kind="option" data-rev="1" data-label="Way A · Refresh inside the fetch wrapper" tabindex="0" data-testid="block-opt-a"><button type="button" class="ask-btn" data-action="ask" data-testid="ask-opt-a">Ask</button><span class="ribbon">RECOMMENDED</span><header class="option-head"><span class="letter">A</span><h3 class="option-name">Refresh inside the fetch wrapper</h3><span class="pattern">Interceptor · retry once</span></header><p class="option-summary" data-testid="summary-opt-a">The fetch wrapper catches a 401, buys a new access token with the refresh token and replays the request once. Callers never see the expiry, and only one file changes.</p><figure class="diagram"><svg xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Refresh inside the fetch wrapper diagram" viewBox="0 0 626.4 134" width="626.4" height="134"><defs><marker id="mk-opt-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse"><path class="arrow" d="M0 0L10 5L0 10z"/></marker></defs><path class="edge" data-from="caller" data-to="wrapper" d="M106.8 41C134.8 41 134.8 41 162.8 41" marker-end="url(#mk-opt-a)"/><path class="edge" data-from="wrapper" data-to="api" d="M274.4 41C302.4 41 302.4 93 330.4 93" marker-end="url(#mk-opt-a)"/><path class="edge" data-from="wrapper" data-to="refresh" data-edge-label="on 401" d="M274.4 41C302.4 41 302.4 41 330.4 41" marker-end="url(#mk-opt-a)"/><text class="edge-label" x="302.4" y="35" text-anchor="middle">on 401</text><path class="edge" data-from="refresh" data-to="session" d="M434.8 41C462.8 41 462.8 41 490.8 41" marker-end="url(#mk-opt-a)"/><g class="node node--external" data-node-id="caller" data-node-label="Call site" data-node-status="external"><title>Call site</title><rect x="24" y="24" width="82.8" height="34" rx="8" style="fill:var(--diagram-external)"/><text x="65.4" y="41" text-anchor="middle" dominant-baseline="central">Call site</text></g><g class="node node--changed" data-node-id="wrapper" data-node-label="Fetch wrapper" data-node-status="changed"><title>Fetch wrapper</title><rect x="162.8" y="24" width="111.6" height="34" rx="8" style="fill:var(--diagram-changed)"/><text x="218.6" y="41" text-anchor="middle" dominant-baseline="central">Fetch wrapper</text></g><g class="node node--new" data-node-id="refresh" data-node-label="Refresh call" data-node-status="new"><title>Refresh call</title><rect x="330.4" y="24" width="104.4" height="34" rx="8" style="fill:var(--diagram-new)"/><text x="382.6" y="41" text-anchor="middle" dominant-baseline="central">Refresh call</text></g><g class="node node--external" data-node-id="api" data-node-label="API" data-node-status="external"><title>API</title><rect x="330.4" y="76" width="72" height="34" rx="8" style="fill:var(--diagram-external)"/><text x="366.4" y="93" text-anchor="middle" dominant-baseline="central">API</text></g><g class="node node--reused" data-node-id="session" data-node-label="Session store" data-node-status="reused"><title>Session store</title><rect x="490.8" y="24" width="111.6" height="34" rx="8" style="fill:var(--diagram-reused)"/><text x="546.6" y="41" text-anchor="middle" dominant-baseline="central">Session store</text></g></svg><button type="button" class="edit-btn" data-action="edit-diagram" data-testid="edit-opt-a">Edit diagram</button></figure><div class="reuses"><code class="chip">src/api/client.ts</code><code class="chip">src/api/retry.ts</code></div><div class="cost"><span class="effort" aria-hidden="true"><span class="pip pip--on"></span><span class="pip"></span><span class="pip"></span></span><span class="pip pip--risk" data-risk="low" aria-hidden="true"></span><span class="cost-label" data-testid="cost-opt-a">Small effort · Low risk</span><span class="cost-note">One file changes and every caller gets the fix without edits.</span></div><p class="why">It reuses the one place every request already passes through</p><footer class="choose"><button type="button" class="choose-btn" data-action="choose" data-testid="choose-opt-a">Choose this way</button></footer><div class="qa" data-testid="qa-opt-a"></div></section>"`;
