{
  "id": "Bad Id",
  "title": "Refresh expired auth tokens",
  "task": "Refresh expired auth tokens without logging the user out",
  "context": {
    "summary": "Every request goes through one fetch wrapper that adds the access token from the session store. When that token expires the API answers 401, and today the wrapper treats any 401 as a logout, so the user loses their place.",
    "terms": [
      {
        "term": "401",
        "meaning": "The HTTP status the API returns when the access token has expired."
      },
      {
        "term": "refresh token",
        "meaning": "A long-lived token in the session store that can buy a new access token."
      },
      {
        "term": "idempotent",
        "meaning": "Safe to send twice; the retry helper only replays requests like this."
      }
    ],
    "flows": [
      {
        "name": "A request with an expired token",
        "steps": [
          "A call site asks the fetch wrapper for data.",
          "The wrapper adds the access token from the session store and sends the request.",
          "The API answers 401 because the access token has expired.",
          "The wrapper treats the 401 as a logout and clears the session, so the user signs in again."
        ],
        "diagram": {
          "nodes": [
            {
              "id": "caller",
