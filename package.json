{
  "name": "pinpoint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "pinpoint": "bin/pinpoint.ts"
  },
  "scripts": {
    "dev": "bun --watch bin/pinpoint.ts serve",
    "demo": "bun bin/pinpoint.ts open test/fixtures/plan.auth-refresh.json",
    "demo:agent": "bun scripts/demo-agent.ts",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:http": "bun test test/http",
    "test:cli": "bun test test/cli",
    "test:daemon": "bun test test/daemon",
    "test:e2e": "playwright test",
    "test:coverage": "bun test --coverage",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "build:skill": "bun bin/pinpoint.ts skill",
    "verify": "bun run check && bun run typecheck && bun run test:coverage && bun run build:skill -- --check && bun run test:e2e"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "hono": "^4.13.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1",
    "typescript": "^5.0.0"
  }
}
